{
  "name": "metodologia-frames-os",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Sucesor de Frames ContentOS por MetodologIA: lo declarado es lo ejecutado.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "11.9.0"
  },
  "bin": {
    "frames": "engine/cli.ts"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "frames": "node engine/cli.ts",
    "gen": "node engine/cli.ts gen",
    "verify": "node verify/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "inventory": "node verify/parity/extract-frames.ts",
    "port:stats": "node verify/port-stats.ts",
    "refs": "node verify/parity/external/reconstruct.ts"
  },
  "dependencies": {
    "docx": "9.7.1",
    "jszip": "3.10.1",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "lucide-static": "1.48.0",
    "playwright": "1.61.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
